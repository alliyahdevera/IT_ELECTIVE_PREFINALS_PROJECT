@model List<HelpDesk.Models.ViewModels.TeamIndexViewModel>
<h2>Teams</h2>
<table class="table table-striped">
    <thead><tr><th>Team</th><th>Department</th><th>Members</th></tr></thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.TeamName</td>
                <td>@t.DepartmentName</td>
                <td>@string.Join(", ", t.Members)</td>
            </tr>
        }
    </tbody>
</table>