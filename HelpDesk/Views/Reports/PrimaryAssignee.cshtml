@model List<HelpDesk.Models.ViewModels.PrimaryAssigneeViewModel>
<h2>Primary Assignee</h2>
<table class="table table-striped">
    <thead><tr><th>Ticket</th><th>Subject</th><th>Primary Assignee</th></tr></thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr><td>@t.TicketId</td><td>@t.Subject</td><td>@t.PrimaryAssigneeName</td></tr>
        }
    </tbody>
</table>
