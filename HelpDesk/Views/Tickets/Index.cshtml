@model List<HelpDesk.Models.ViewModels.TicketIndexViewModel>
<h2>Tickets</h2>
<table class="table table-striped">
    <thead><tr><th>ID</th><th>Subject</th><th>Customer</th><th>Category</th><th>Priority</th><th>Status</th><th>Created</th><th>Due</th></tr></thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.Id</td>
                <td><a asp-action="Details" asp-route-id="@t.Id">@t.Subject</a></td>
                <td>@t.CustomerCompany</td>
                <td>@t.CategoryName</td>
                <td>@t.PriorityName</td>
                <td>@t.StatusName</td>
                <td>@t.CreatedAt.ToString("yyyy-MM-dd")</td>
                <td>@(t.DueAt?.ToString("yyyy-MM-dd") ?? "-")</td>
            </tr>
        }
    </tbody>
</table>